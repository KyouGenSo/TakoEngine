<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ===================================================
       共有プロパティ
       MSBuildThisFileDirectory はこの .props 自身の場所を指すので、
       import 元の物理パスに依存しない。
       =================================================== -->
  <PropertyGroup>
    <TakoEngineRoot>$(MSBuildThisFileDirectory)..</TakoEngineRoot>
    <EngineResourcesSrc>$(TakoEngineRoot)\project\engine\resources</EngineResourcesSrc>
    <EngineResourcesDirName>EngineResources</EngineResourcesDirName>
    <GameResourcesSrc>$(ProjectDir)resources</GameResourcesSrc>
    <GameResourcesDirName>resources</GameResourcesDirName>
  </PropertyGroup>

  <!-- ===================================================
       出力 / 中間ディレクトリ規約
       全ゲームプロジェクトで $(SolutionDir)\Generated\... 配下に統一。
       OutDir は Configuration 単位でフラット（DLL/exe/リソース同居）、
       IntDir は ProjectName で分離して複数ゲーム同時ビルドにも対応。
       Debug/Release で同じ式なので Condition 不要。
       =================================================== -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)\Generated\outputs\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)\Generated\obj\$(ProjectName)\$(Configuration)\</IntDir>
    <IncludePath>$(WindowsSDK_IncludePath);$(ProjectDir);$(VC_IncludePath);$(IncludePath)</IncludePath>
  </PropertyGroup>

  <!-- ===================================================
       Visual Studio から F5 起動した時の作業ディレクトリ
       （exe の隣 = OutDir）に統一。
       これで「VS から実行」も「exe ダブルクリック」も
       同じ相対パス解決になる。

       注意: $(OutDir) は .props 評価時点ではまだ未定義のため
       eager 評価で空になる。$(SolutionDir) と $(Configuration) は
       MSBuild の予約プロパティで先に確定するため、これらを使って
       OutDir 規約を直接記述する。
       =================================================== -->
  <PropertyGroup>
    <LocalDebuggerWorkingDirectory>$(SolutionDir)Generated\outputs\$(Configuration)\</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- ===================================================
       共通 C++ コンパイラ / リンカ設定
       Debug/Release 両方に適用される最大公約数。
       Configuration 固有の差分（最適化や RuntimeLibrary）は
       下の ItemDefinitionGroup（Debug|Release）で個別指定する。
       =================================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- ===================================================
       Debug 固有: RuntimeLibrary（MTd）+ プリプロセッサ
       =================================================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ===================================================
       Release 固有: RuntimeLibrary（MT）+ 最適化 + プリプロセッサ
       /O1 系（MinSpace）はサイズ優先。速度優先なら MaxSpeed に切替。
       =================================================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <Optimization>MinSpace</Optimization>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ===================================================
       PreBuildEvent: リソースを OutDir 直下にミラー
       /XO により更新分だけコピーするので増分ビルドに優しい。
       robocopy の終了コード 0..7 は成功扱い、8 以上だけ真のエラー。
       =================================================== -->
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Command>robocopy "$(EngineResourcesSrc)" "$(OutDir)$(EngineResourcesDirName)" /E /XO /NFL /NDL /NJH /NJS /NP /NS /NC
IF %ERRORLEVEL% GEQ 8 EXIT /B %ERRORLEVEL%
robocopy "$(EngineResourcesSrc)" "$(ProjectDir)$(EngineResourcesDirName)" /E /XO /NFL /NDL /NJH /NJS /NP /NS /NC
IF %ERRORLEVEL% GEQ 8 EXIT /B %ERRORLEVEL%
robocopy "$(GameResourcesSrc)" "$(OutDir)$(GameResourcesDirName)" /E /XO /NFL /NDL /NJH /NJS /NP /NS /NC
IF %ERRORLEVEL% GEQ 8 EXIT /B %ERRORLEVEL%
EXIT /B 0</Command>
      <Message>Copying engine resources to $(OutDir) and $(ProjectDir), and game resources to $(OutDir)</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>

  <!-- ===================================================
       PostBuildEvent: DXC ランタイム DLL を exe の隣に配置
       全 DX12 ゲームに必須なので .props で集約。
       =================================================== -->
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Command>copy /Y "$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxcompiler.dll" "$(TargetDir)dxcompiler.dll"
copy /Y "$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxil.dll" "$(TargetDir)dxil.dll"</Command>
      <Message>Copying DXC runtime DLLs</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>

</Project>
